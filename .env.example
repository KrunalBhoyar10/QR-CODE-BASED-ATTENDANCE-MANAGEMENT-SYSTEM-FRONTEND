# API Configuration
REACT_APP_API_URL=http://localhost:3000/api/v1

# Backend API Base URL (Vite). On desktop dev you can omit this — the app uses /api/v1 via the Vite proxy.
# Do NOT use localhost here when testing on a phone over LAN; the client auto-uses https://<your-ip>:3000/api/v1.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Backend proxy target (dev only, on the PC running npm run dev)
VITE_PROXY_TARGET=http://localhost:5000

# Organization Email Domain (must match backend ORGANIZATION_EMAIL_DOMAIN)
VITE_ORGANIZATION_EMAIL_DOMAIN=abcuniversity.edu.in

# Optional: Override default port (development only)
# PORT=3001

# Optional: Browser auto-open (development only)
# BROWSER=none

# Optional: Performance profiling (development only)
# REACT_APP_PROFILE=true