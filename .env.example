# API Configuration
REACT_APP_API_URL=http://localhost:3000/api/v1

# Backend API Base URL (Vite)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Organization Email Domain (must match backend ORGANIZATION_EMAIL_DOMAIN)
VITE_ORGANIZATION_EMAIL_DOMAIN=abcuniversity.edu.in

# Optional: Override default port (development only)
# PORT=3001

# Optional: Browser auto-open (development only)
# BROWSER=none

# Optional: Performance profiling (development only)
# REACT_APP_PROFILE=true